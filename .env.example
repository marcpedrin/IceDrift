# ============================================================
# IceNavigator - Environment Variables
# Copy this file to .env and fill in your keys
# ============================================================

# --- Copernicus Climate Data Store (ERA5 winds) ---
# Register at: https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=your-uid:your-api-key

# --- NASA Earthdata (NSIDC sea ice, OSCAR currents) ---
# Register at: https://urs.earthdata.nasa.gov/
EARTHDATA_USER=your_earthdata_username
EARTHDATA_PASS=your_earthdata_password

# --- MarineTraffic AIS API ---
# Register at: https://www.marinetraffic.com/en/ais-api
MARINETRAFFIC_API_KEY=your_marinetraffic_api_key

# --- Sentinel Hub (satellite imagery) ---
# Register at: https://www.sentinel-hub.com/
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret
SENTINEL_HUB_INSTANCE_ID=your_sentinel_hub_instance_id

# --- Cesium Ion (3D globe tiles) ---
# Register at: https://cesium.com/ion/ (free tier available)
CESIUM_ION_TOKEN=your_cesium_ion_access_token

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Model & Data Paths ---
MODEL_CACHE_DIR=./checkpoints
DATA_DIR=./data

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_CESIUM_TOKEN=your_cesium_ion_access_token
